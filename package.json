{
  "name": "md_reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "productName": "md_reader",
  "main": "desktop/main.cjs",
  "description": "md_reader — 本地 Markdown 与文本读写工具",
  "scripts": {
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "desktop": "electron .",
    "package:desktop": "node scripts/package-desktop.mjs",
    "test": "node scripts/api-test.mjs",
    "test:api": "node scripts/api-test.mjs",
    "test:ui": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.4.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
